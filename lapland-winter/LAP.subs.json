{
  "prefix": "LAP",
  "title": "夢幻祕境・芬蘭拉普蘭 7 天遊",
  "subs": [
    {
      "id": "001",
      "scene": "s01",
      "text": "",
      "dur": 2.5
    },
    {
      "id": "002",
      "scene": "s01",
      "text": "夢幻祕境——芬蘭拉普蘭七天遊，一場走進北極圈的冬季童話。",
      "dur": 5.93
    },
    {
      "id": "003",
      "scene": "s02",
      "text": "七天六夜，從首都赫爾辛基一路北上，深入聖誕老人的故鄉羅瓦涅米。",
      "dur": 7.09
    },
    {
      "id": "004",
      "scene": "s02",
      "text": "極光、馴鹿、哈士奇、冰釣、聖誕老人村，北極的精華一次收齊。",
      "dur": 6.81
    },
    {
      "id": "005",
      "scene": "s02",
      "text": "五晚住宿、來回夜臥火車、專業導遊與所有活動門票，通通包含在內。",
      "dur": 7.05
    },
    {
      "id": "006",
      "scene": "s03",
      "text": "第一天，我們在赫爾辛基展開城市漫遊。",
      "dur": 3.65
    },
    {
      "id": "007",
      "scene": "s03",
      "text": "走訪雪白莊嚴的赫爾辛基大教堂，與紅磚的烏斯別斯基大教堂。",
      "dur": 6.21
    },
    {
      "id": "008",
      "scene": "s03",
      "text": "再逛逛海邊的露天市集，於西貝流士公園畫下句點。",
      "dur": 5.25
    },
    {
      "id": "009",
      "scene": "s03",
      "text": "傍晚登上夜臥火車，一覺醒來，就是北極圈。",
      "dur": 4.29
    },
    {
      "id": "010",
      "scene": "s04",
      "text": "第二天，歡迎來到羅瓦涅米——聖誕老人的官方故鄉。",
      "dur": 4.85
    },
    {
      "id": "011",
      "scene": "s04",
      "text": "在聖誕老人村跨越北極圈白線，拿到專屬的北極圈證書。",
      "dur": 5.77
    },
    {
      "id": "012",
      "scene": "s05",
      "text": "接著，見到童年夢想中的主角——聖誕老人本人。",
      "dur": 4.33
    },
    {
      "id": "013",
      "scene": "s05",
      "text": "和他聊聊天、合張影，把願望親口說給他聽。",
      "dur": 4.57
    },
    {
      "id": "014",
      "scene": "s06",
      "text": "第三天是極地活動日。",
      "dur": 2.37
    },
    {
      "id": "015",
      "scene": "s06",
      "text": "踏上雪鞋，穿越白雪覆蓋的原始森林，每一步都鬆軟無聲。",
      "dur": 5.69
    },
    {
      "id": "016",
      "scene": "s07",
      "text": "來到冰封的湖面，用冰鑽鑿開三十公分厚的冰層，體驗芬蘭式冰釣。",
      "dur": 6.49
    },
    {
      "id": "017",
      "scene": "s07",
      "text": "午後圍著篝火享用燒烤，夜幕降臨後，前往觀景點守候第一場極光。",
      "dur": 6.41
    },
    {
      "id": "018",
      "scene": "s08",
      "text": "第四天，先登上北極圈旁的烏納斯瓦拉山丘，飽覽羅瓦涅米全景。",
      "dur": 6.09
    },
    {
      "id": "019",
      "scene": "s08",
      "text": "隨後前往拉努阿野生動物園，探訪北極熊等兩百多隻極地動物。",
      "dur": 5.73
    },
    {
      "id": "020",
      "scene": "s08",
      "text": "第五天遊覽市區，走進暱稱極光教堂的羅瓦涅米大教堂與市政廳。",
      "dur": 6.53
    },
    {
      "id": "021",
      "scene": "s09",
      "text": "第六天，拜訪原始森林裡的馴鹿牧場。",
      "dur": 3.65
    },
    {
      "id": "022",
      "scene": "s09",
      "text": "與薩米牧民聊聊他們與馴鹿相伴的日常，親手餵食這些溫柔的大傢伙。",
      "dur": 6.41
    },
    {
      "id": "023",
      "scene": "s09",
      "text": "再裹上暖毯，搭乘馴鹿雪橇滑進森林，還能拿到一張馴鹿雪橇駕照。",
      "dur": 6.57
    },
    {
      "id": "024",
      "scene": "s10",
      "text": "最後一天，前往哈士奇牧場。",
      "dur": 2.73
    },
    {
      "id": "025",
      "scene": "s10",
      "text": "一群熱情的雪橇犬將帶著你，在林間雪道上飛馳。",
      "dur": 4.53
    },
    {
      "id": "026",
      "scene": "s11",
      "text": "入夜後，再一次出發狩獵北極光。",
      "dur": 3.69
    },
    {
      "id": "027",
      "scene": "s11",
      "text": "當綠色光幕在頭頂舞動，這趟旅程的一切都值得了。",
      "dur": 4.73
    },
    {
      "id": "028",
      "scene": "s12",
      "text": "大人一千九百九十九歐元起，這個冬天，跟著專業導遊走進北極圈的童話。",
      "dur": 6.41
    },
    {
      "id": "029",
      "scene": "s12",
      "text": "",
      "dur": 4
    }
  ]
}
